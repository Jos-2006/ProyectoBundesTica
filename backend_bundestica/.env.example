# Configuración privada para PowerShell o CMD; Django lee variables del sistema.
# Este archivo NO se carga automáticamente. No guardes contraseñas reales aquí.
DJANGO_SECRET_KEY=colocar_clave_privada_local
USE_MYSQL=True
MYSQL_DATABASE=Bundestica
MYSQL_USER=root
MYSQL_PASSWORD=colocar_contrasena_local
MYSQL_HOST=localhost
MYSQL_PORT=3306
